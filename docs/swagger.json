    "basePath": "/",
    "paths": {
        "/email": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Retrieves all emails for a specific consumer",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Email"
                ],
                "summary": "Get all emails",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/email.Email"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/common.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/email/send": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Sends an email with the provided parameters",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Email"
                ],
                "summary": "Send an email",
                "parameters": [
                    {
                        "description": "Email parameters",
                        "name": "email",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/email.EmailParams"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/email.Email"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/common.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/email/subdomain-ownerships": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Creates a subdomain ownership record for a consumer",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Email"
                ],
                "summary": "Create a subdomain ownership",
                "parameters": [
                    {
                        "description": "Subdomain ownership parameters",
                        "name": "subdomainOwnership",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/email.SubdomainOwnership"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/email.SubdomainOwnership"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/common.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "description": "Check if the server is running",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/sendgrid/webhooks/event": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Processes events from SendGrid webhook, such as email opens",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Email"
                ],
                "summary": "Handle SendGrid webhook events",
                "parameters": [
                    {
                        "description": "SendGrid events",
                        "name": "events",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/email.SendGridEvent"
                            }
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/common.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/text-message": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Get text messages for a consumer",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "TextMessage"
                ],
                "summary": "Get text messages",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/textmessage.TextMessage"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/common.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/common.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/text-message/send": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Send a text message to a recipient",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "TextMessage"
                ],
                "summary": "Send a text message",
                "parameters": [
                    {
                        "description": "Text message parameters",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/textmessage.TextMessageParams"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/textmessage.TextMessage"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/common.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/common.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/text-message/webhooks/delivery-receipt": {
            "get": {
                "description": "Receive text message webhook",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "TextMessage"
                ],
                "summary": "Receive text message webhook",
                "parameters": [
                    {
                        "type": "string",
                        "name": "api-key",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "name": "client-ref",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "name": "err-code",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "name": "message-timestamp",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "name": "messageId",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "name": "msisdn",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "name": "network-code",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "name": "price",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "name": "scts",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "name": "status",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "name": "timestamp",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "name": "to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/common.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/text-message/{messageId}": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Get a specific text message for a consumer",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "TextMessage"
                ],
                "summary": "Get a text message",
                "parameters": [
                    {
                        "type": "string",
                        "description": "MessageId",
                        "name": "messageId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/textmessage.TextMessage"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/common.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "common.ErrorResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                }
            }
        },
        "email.Email": {
            "description": "Email information and status",
            "type": "object",
            "properties": {
                "consumer": {
                    "description": "Consumer identifier",
                    "type": "string"
                },
                "createdAt": {
                    "description": "Timestamp when the email was created",
                    "type": "string"
                },
                "emailSubject": {
                    "description": "Subject of the email",
                    "type": "string"
                },
                "emailText": {
                    "description": "Plain text content of the email",
                    "type": "string"
                },
                "enableOpenTracking": {
                    "description": "EnableOpenTracking indicates if open tracking is enabled for the email",
                    "type": "boolean"
                },
                "html": {
                    "description": "HTML content of the email",
                    "type": "string"
                },
                "opened": {
                    "description": "Opened indicates if the email has been opened",
                    "type": "boolean"
                },
                "recipientEmail": {
                    "description": "Email address of the recipient",
                    "type": "string"
                },
                "recipientName": {
                    "description": "Name of the recipient",
                    "type": "string"
                },
                "senderEmail": {
                    "description": "Email address of the sender",
                    "type": "string"
                },
                "senderName": {
                    "description": "Name of the sender",
                    "type": "string"
                },
                "status": {
                    "description": "Current status of the email",
                    "type": "string"
                },
                "transactionUuid": {
                    "description": "Unique identifier for the email transaction",
                    "type": "string"
                },
                "userName": {
                    "description": "Name of the user sending the email",
                    "type": "string"
                }
            }
        },
        "email.EmailParams": {
            "description": "Parameters required to send an email",
            "type": "object",
            "required": [
                "emailSubject",
                "emailText",
                "enableOpenTracking",
                "html",
                "recipientEmail",
                "recipientName",
                "senderEmail",
                "senderName",
                "userName"
            ],
            "properties": {
                "emailSubject": {
                    "description": "Subject of the email",
                    "type": "string"
                },
                "emailText": {
                    "description": "Plain text content of the email",
                    "type": "string"
                },
                "enableOpenTracking": {
                    "description": "EnableOpenTracking indicates if open tracking is enabled for the email",
                    "type": "boolean"
                },
                "html": {
                    "description": "HTML content of the email",
                    "type": "string"
                },
                "recipientEmail": {
                    "description": "Email address of the recipient",
                    "type": "string"
                },
                "recipientName": {
                    "description": "Name of the recipient",
                    "type": "string"
                },
                "senderEmail": {
                    "description": "Email address of the sender",
                    "type": "string"
                },
                "senderName": {
                    "description": "Name of the sender",
                    "type": "string"
                },
                "userName": {
                    "description": "Name of the user sending the email",
                    "type": "string"
                }
            }
        },
        "email.SendGridEvent": {
            "type": "object",
            "properties": {
                "email": {
                    "description": "Email address of the recipient",
                    "type": "string"
                },
                "event": {
                    "description": "Type of event (e.g., \"open\", \"click\")",
                    "type": "string"
                },
                "ip": {
                    "description": "IP address of the recipient",
                    "type": "string"
                },
                "sg_content_type": {
                    "description": "Content type of the email",
                    "type": "string"
                },
                "sg_event_id": {
                    "description": "Event ID from SendGrid",
                    "type": "string"
                },
                "sg_machine_open": {
                    "description": "Indicates if the email was opened by a machine",
                    "type": "boolean"
                },
                "sg_message_id": {
                    "description": "Message ID from SendGrid",
                    "type": "string"
                },
                "timestamp": {
                    "description": "Timestamp of the event",
                    "type": "integer"
                },
                "transaction_uuid": {
                    "description": "Transaction UUID associated with the email",
                    "type": "string"
                },
                "useragent": {
                    "description": "User agent of the recipient's device",
                    "type": "string"
                }
            }
        },
        "email.SubdomainOwnership": {
            "type": "object",
            "properties": {
                "api_key": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "subdomain_id": {
                    "type": "string"
                },
                "subdomain_ownership_uuid": {
                    "description": "ID of the subdomain ownership record",
                    "type": "string"
                }
            }
        },
        "textmessage.TextMessage": {
            "type": "object",
            "properties": {
                "consumer": {
                    "type": "string"
                },
                "createdAt": {
                    "type": "string"
                },
                "messageID": {
                    "type": "string"
                },
                "recipient": {
                    "type": "string"
                },
                "sender": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "userName": {
                    "type": "string"
                }
            }
        },
        "textmessage.TextMessageParams": {
            "type": "object",
            "required": [
                "recipient",
                "sender",
                "text",
                "userName"
            ],
            "properties": {
                "recipient": {
                    "type": "string"
                },
                "sender": {
                    "type": "string"
                },
                "text": {
                    "type": "string"
                },
                "userName": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "type": "apiKey",
            "name": "x-application-id",
            "in": "header"
        }
    }
}